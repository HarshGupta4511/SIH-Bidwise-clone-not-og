# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=sqlite:///./bidverify.db
# Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://bidverify:bidverify@postgres:5432/bidverify

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

UPLOAD_DIR=./uploads

# LLM provider: "gemini" 
# (free tier via Google AI Studio — same key also powers Gemini vision OCR).
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=AQ.Ab8RN6LXj5AQuG255-Wc6bjVCjT134_y6bplJX7ykD50hDaYnQ
GEMINI_MODEL=gemini-2.5-flash-lite

# OCR engine for scanned PDFs: "paddle" (local, default) or "gemini"
# (Gemini vision API — needs GEMINI_API_KEY above).
OCR_PROVIDER=gemini

# Frontend
VITE_API_URL=http://localhost:8000/api
